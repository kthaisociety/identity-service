# Bind address for both listeners. Empty (the default) binds all interfaces, which the container needs.
# Keep 127.0.0.1 for local dev: anything on 0.0.0.0 on a machine with a public IP is reachable from the
# internet.
HOST=127.0.0.1
# Public listener (sign-in) and internal listener (internal API). The image uses 8000 and 8001; these
# avoid clashing locally with growth-portal (8000) and luma-service (8001).
PUBLIC_PORT=8010
INTERNAL_PORT=8011

# Postgres; `docker compose up -d` starts this one.
DATABASE_URL=postgres://identity:identity@127.0.0.1:5437/identity?sslmode=disable

# Shared secret callers of the internal API send as X-Service-Secret. Generate with:
# openssl rand -base64 32
IDENTITY_SERVICE_SECRET=<IDENTITY_SERVICE_SECRET>

# Public URL of this service. In staging/production use its real HTTPS origin.
OIDC_ISSUER=http://127.0.0.1:8010
GOOGLE_CLIENT_ID=<Google OAuth client ID>
GOOGLE_CLIENT_SECRET=<Google OAuth client secret>
# Register this exact URL in the Google OAuth client.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/auth/callback

# One RSA private key for signing JWTs, PEM bytes encoded as base64. Keep the
# same value across restarts. The separate 32-byte key encrypts OIDC codes.
OIDC_SIGNING_KEY_PEM_BASE64=<base64-encoded RSA private key PEM>
OIDC_CRYPTO_KEY_BASE64=<base64-encoded 32 random bytes>

# Exact redirect URI allowlist. The secret is for the app backend, not browsers.
OIDC_CLIENTS_JSON=[{"id":"local-dev","secret":"<client secret>","redirect_uris":["http://127.0.0.1:8012/callback"],"post_logout_redirect_uris":["http://127.0.0.1:8012/"]}]
